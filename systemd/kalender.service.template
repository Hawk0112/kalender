[Unit]
Description=Kalender - Datendienst fuer die Wochenansicht
Documentation=file://__APPDIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APPDIR__
ExecStart=__APPDIR__/.venv/bin/python -m app.server --config __APPDIR__/config.yaml
Restart=always
RestartSec=5
# Die Uhrzeit muss stimmen, sonst zeigt der Kalender den falschen Tag.
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
